{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Uvicorn Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "back_end.app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: Current File",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Open index.html",
      "file": "${workspaceFolder}/front_end/html files/index.html"
    }
  ]
}